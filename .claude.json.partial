{
  "mcpServers": {
    "filesystem": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "{{HOME}}"
      ],
      "env": {}
    },
    "librarian": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "{{FEYNMAN_LIBRARY}}\\.venv\\Scripts\\python.exe",
        "-m",
        "librarian_mcp.server"
      ],
      "env": {
        "PYTHONPATH": "{{FEYNMAN_LIBRARY}}\\.trae",
        "PYTHONUNBUFFERED": "1"
      }
    },
    "excel": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@negokaz/excel-mcp-server"
      ],
      "env": {}
    },
    "mongodb": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "mongodb-mcp-server"
      ],
      "env": {
        "MONGODB_URI": "mongodb://localhost:27017"
      }
    },
    "http": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "mcp-fetch-server"
      ],
      "env": {}
    },
    "playwright": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@playwright/mcp@latest"
      ],
      "env": {}
    },
    "ssh": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "mcp-server-ssh"
      ],
      "env": {}
    },
    "shell": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@wonderwhy-er/desktop-commander"
      ],
      "env": {}
    },
    "sqlite": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "mcp-sqlite",
        "{{HOME}}\\.claude\\data.db"
      ],
      "env": {}
    },
    "git": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "-p",
        "github-mcp-server",
        "github-mcp-server-mcp"
      ],
      "env": {}
    }
  },
  "project": {
    "enabledMcpjsonServers": [
      "filesystem",
      "shell",
      "git",
      "http",
      "mongodb",
      "sqlite",
      "excel",
      "playwright",
      "ssh"
    ],
    "disabledMcpjsonServers": [],
    "hasTrustDialogAccepted": true
  }
}