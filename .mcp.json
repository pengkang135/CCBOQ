{
  "filesystem": {
    "command": "npx",
    "args": [
      "-y",
      "@modelcontextprotocol/server-filesystem",
      "{{HOME}}"
    ]
  },
  "shell": {
    "command": "npx",
    "args": [
      "-y",
      "@wonderwhy-er/desktop-commander"
    ]
  },
  "git": {
    "command": "npx",
    "args": [
      "-y",
      "-p",
      "github-mcp-server",
      "github-mcp-server-mcp"
    ]
  },
  "http": {
    "command": "npx",
    "args": [
      "-y",
      "mcp-fetch-server"
    ]
  },
  "mongodb": {
    "command": "npx",
    "args": [
      "-y",
      "mongodb-mcp-server"
    ],
    "env": {
      "MONGODB_URI": "mongodb://localhost:27017"
    }
  },
  "sqlite": {
    "command": "npx",
    "args": [
      "-y",
      "mcp-sqlite",
      "{{HOME}}\\.claude\\data.db"
    ]
  },
  "excel": {
    "command": "npx",
    "args": [
      "-y",
      "@negokaz/excel-mcp-server"
    ]
  },
  "playwright": {
    "command": "npx",
    "args": [
      "-y",
      "@playwright/mcp@latest",
      "--output-dir",
      "temp/playwright-mcp"
    ]
  },
  "librarian": {
    "command": "cmd",
    "args": [
      "/c",
      "{{FEYNMAN_LIBRARY}}\\.venv\\Scripts\\python.exe",
      "-m",
      "librarian_mcp.server"
    ],
    "env": {
      "PYTHONPATH": "{{FEYNMAN_LIBRARY}}\\.trae",
      "PYTHONUNBUFFERED": "1"
    }
  },
  "ssh": {
    "command": "npx",
    "args": [
      "-y",
      "mcp-server-ssh"
    ]
  },
  "rapid-ocr": {
    "command": "{{HOME}}\\.claude\\mcp-servers\\rapid-ocr\\.venv\\Scripts\\python.exe",
    "args": [
      "{{HOME}}\\.claude\\mcp-servers\\rapid-ocr\\server.py"
    ]
  },
  "chrome-devtools": {
    "command": "npx",
    "args": [
      "-y",
      "chrome-devtools-mcp@latest",
      "--headless"
    ]
  },
  "serena": {
    "command": "uvx",
    "args": [
      "--from",
      "git+https://github.com/oraios/serena",
      "serena",
      "start-mcp-server"
    ]
  }
}