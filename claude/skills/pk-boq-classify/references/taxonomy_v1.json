  "worker_output_schema": {
    "row_id": "int (原表行号,如 227)",
    "discipline": "A | B | C | PRELIM | FREE",
    "category_code": "如 A.06 / B.06 / C.02 / PRELIM / null",
    "category_name": "如 混凝土及钢筋 / 电气安装 / 道路工程",
    "subcategory_code": "如 A.06.01 (若可确定) / null",
    "subcategory_name": "对应中文子分部名 / null",
    "material": "英文原词或中文提炼,如 Concrete f'c25 / 现浇砼",
    "spec": "如 M / M3 单位对应的规格,f'c(MPa)25 / DN100 / 3mm",
    "candidate_item_codes": [
      "top-3 定额子目 code (给下游 pk-norms-match 用)"
    ],
    "confidence": "0-1",
    "reason": "一句话理由 (可选,置信度<0.7时必填)"
  },
  "confidence_bands": {
    "high": ">=0.85 → 直接采纳",
    "medium": "0.60~0.85 → 进 Sonnet 抽检 (10%抽样)",
    "low": "<0.60 → 强制送 Sonnet 复核, 再低于 0.5 送 Opus 仲裁"
  },
  "pipeline": {
    "T0_taxonomy": "本文件 + candidate_retrieval.py + worker_prompt.md (架构师 Opus, 一次性)",
    "T1_coordinator": "Sonnet: 读BOQ→追溯Dept→分组→对每组Description跑候选检索→打包分片",
    "T2_workers": "Haiku × N: 每片输入(Dept上下文+候选池+行列表)→输出JSON按schema",
    "T3_audit": "Sonnet 抽检+跨组一致性;Opus 疑难仲裁 (<2%行)",
    "T4_writeback": "Python 批量写 O~S; Opus 检查整体分布合理性",
    "T5_downstream": "分类完成即可无缝进入 pk-norms-match / pk-boq-db-match 套单价"
  },
  "known_risks": [
    "PRELIM/General 条目占比高(约1/3),不要送 Haiku 分类,直接规则命中",
    "SECTION HEADER (含 {} 或 【】) 已由 hierarchy 处理,不参与 O~S 填写",
    "英文单位大小写不一致 (M/m/M3/m3/No./No/Nos),需 unit_normalize",
    "现有分类列已填一版(质量参差),不做 diff,直接覆写"
  ]
}