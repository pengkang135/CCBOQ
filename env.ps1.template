# env.ps1.template — Environment variable reference
# Copy to env.ps1 and fill in actual values. env.ps1 is gitignored.
#
# deploy.ps1 auto-loads env.ps1 if present, otherwise collects interactively.
# All {{VAR}} placeholders in template files are replaced with values defined here.

# --- Claude Code ---
$ENV:ANTHROPIC_BASE_URL       = "https://api.deepseek.com/anthropic"
$ENV:ANTHROPIC_AUTH_TOKEN     = "sk-..."           # Required: DeepSeek API key
$ENV:ANTHROPIC_MODEL          = "deepseek-v4-pro"
$ENV:DEFAULT_HAIKU_MODEL      = "deepseek-v4-flash"
$ENV:DEFAULT_SONNET_MODEL     = "deepseek-v4-pro"
$ENV:DEFAULT_OPUS_MODEL       = "deepseek-v4-pro"
$ENV:GITHUB_PERSONAL_ACCESS_TOKEN = "ghp_..."     # GitHub PAT

# --- OpenClaw ---
$ENV:OPENCLAW_GATEWAY_TOKEN   = ""                 # 32-char hex, leave empty to auto-generate
$ENV:TELEGRAM_BOT_TOKEN       = "..."              # Required: Telegram Bot Token
$ENV:TELEGRAM_OWNER_ID        = ""                 # Telegram user numeric ID

# --- System paths ---
# deploy.ps1 auto-detects these; values below are for reference only
$ENV:HOME                     = $env:USERPROFILE
$ENV:HOME_WIN                 = $env:USERPROFILE   # Windows style (C:\Users\...)
$ENV:PYTHONW_PATH             = ""                 # pythonw.exe path, leave empty to auto-detect
$ENV:FFMPEG_PATH              = "C:\Program Files\ffmpeg\bin\ffmpeg.exe"

# --- Git ---
$ENV:GIT_USER_NAME            = "Kevin Peng"
$ENV:GIT_USER_EMAIL           = ""                 # Git commit email
