{
  "env": {
    "ANTHROPIC_BASE_URL": "{{ANTHROPIC_BASE_URL}}",
    "ANTHROPIC_AUTH_TOKEN": "{{ANTHROPIC_AUTH_TOKEN}}",
    "ANTHROPIC_MODEL": "{{ANTHROPIC_MODEL}}",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "{{ANTHROPIC_DEFAULT_HAIKU_MODEL}}",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "{{ANTHROPIC_DEFAULT_SONNET_MODEL}}",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "{{ANTHROPIC_DEFAULT_OPUS_MODEL}}",
    "DISABLE_TELEMETRY": "1",
    "DISABLE_FEEDBACK_COMMAND": "1",
    "DISABLE_ERROR_REPORTING": "1"
  },
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "WebSearch",
      "WebFetch",
      "Edit",
      "Write",
      "NotebookEdit",
      "Bash(*)",
      "mcp__*",
      "mcp__ssh__ssh_exec",
      "mcp__shell__force_terminate"
    ],
    "ask": [
      "mcp__mongodb__drop-database",
      "mcp__mongodb__drop-collection",
      "mcp__mongodb__delete-many",
      "mcp__mongodb__drop-index",
      "mcp__sqlite__delete_records",
      "mcp__ssh__sftp_rm",
      "mcp__git__git-reset",
      "mcp__git__git-rebase",
      "mcp__playwright__browser_run_code_unsafe",
      "mcp__plugin_playwright_playwright__browser_run_code_unsafe",
      "Bash(rm *)",
      "Bash(del *)",
      "Bash(rmdir *)",
      "Bash(taskkill *)"
    ],
    "additionalDirectories": [
      "c:\\Users\\Kevin\\AppData\\Roaming\\Trae\\User",
      "{{HOME}}\\.claude"
    ],
    "prompts": {
      "bash": [
        "git *",
        "uvx *",
        "check *",
        "show *",
        "list *",
        "run test *",
        "run tests *",
        "install *",
        "python *",
        "pip *",
        "npm *",
        "npx *",
        "build *",
        "create *",
        "delete *",
        "remove *",
        "clean *",
        "powershell *",
        "dir *",
        "type *",
        "findstr *",
        "where *",
        "tasklist *",
        "taskkill *",
        "choco *",
        "winget *",
        "scoop *",
        "Get-*",
        "Set-*",
        "New-*",
        "Remove-*",
        "Write-*",
        "Copy-*",
        "Move-*",
        "Start-*",
        "Stop-*",
        "mkdir *",
        "rmdir *",
        "del *",
        "ren *",
        "echo *",
        "set *",
        "setx *",
        "reg *"
      ]
    }
  },
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -STA -File \"{{HOME}}/claude-code-config/sounds/play-mp3.ps1\" -Path \"{{HOME}}/claude-code-config/sounds/command-complete-fantasy_ui_button.mp3\"",
            "timeout": 15,
            "statusMessage": "🔊",
            "async": true
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -File \"{{HOME}}\\.claude\\auto-approve-safe-tools.ps1\"",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -STA -File \"{{HOME}}/claude-code-config/sounds/play-mp3.ps1\" -Path \"{{HOME}}/claude-code-config/sounds/permission-prompt-ship-bell-two-chimes.mp3\"",
            "timeout": 10,
            "statusMessage": "🔔",
            "async": true
          }
        ]
      }
    ]
  },
  "language": "chinese",
  "theme": "dark",
  "effortLevel": "max",
  "includeCoAuthoredBy": false,
  "skipDangerousModePermissionPrompt": true,
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "code-modernization@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "hookify@claude-plugins-official": true,
    "session-report@claude-plugins-official": true,
    "chrome-devtools-mcp@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true
  }
}